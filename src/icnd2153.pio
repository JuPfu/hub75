.pio_version 0

.program icnd2153_row

; OEN pin
.side_set 1

.wrap_target
    mov x, isr       side 0      ; reload rows-remaining-this-frame
    irq nowait 2     side 0     ; request VSYNC from the data SM
    wait 1 irq 3     side 0      ; wait for its "VSYNC sent" ack

    set pins, 0b101 [3] side 0   ; seed row 0 into the RA/RC shift-chain: RA=1 RC=1
    set pins, 0b000 [3] side 0   ; RA=0 RC=0

row_loop:
    out y, 32            side 0   ; reload burst length
gclk_loop:
    nop                [3] side 1   ; GCLK high
    jmp y--, gclk_loop [3] side 0   ; GCLK low; loop 138 times total

    ; irq nowait 4        side 0    ; trigger this row's GCLK burst
    ; wait 1 irq 5        side 0     ; wait for icnd2153_gclk to finish it

    set pins, 0b001 [3]   side 0   ; RA=1 - advance to next row
    set pins, 0b000 [3]   side 0   ; RA=0

    jmp x--, row_loop     side 0
.wrap

% c-sdk {
    static inline void icnd2153_row_program_init(PIO pio, uint sm, uint offset, uint rowsel_base_pin, uint oen_pin, uint32_t num_scan_rows)
    {
        pio_sm_set_enabled(pio, sm, false);
        pio_sm_clear_fifos(pio, sm);

        pio_sm_set_consecutive_pindirs(pio, sm, rowsel_base_pin, 3, true);
        pio_sm_set_consecutive_pindirs(pio, sm, oen_pin, 1, true);
        for (uint i = 0; i < 3; i++)
            pio_gpio_init(pio, rowsel_base_pin + i);
        pio_gpio_init(pio, oen_pin);

        pio_sm_config c = icnd2153_row_program_get_default_config(offset);
        sm_config_set_set_pins(&c, rowsel_base_pin, 3);
        sm_config_set_sideset_pins(&c, oen_pin);
        sm_config_set_out_shift(&c, true, false, 32);

        sm_config_set_clkdiv(&c, 10.0f);

        pio_sm_init(pio, sm, offset, &c);

        // Seed y = num_scan_rows - 1 (frame-reload constant - see the .program
        // comments; this is the only time isr is ever written after init).
        pio_sm_exec(pio, sm, pio_encode_out(pio_isr, 32));
        pio_sm_put(pio, sm, num_scan_rows - 1);

        pio_sm_set_enabled(pio, sm, true);
    }
%}

; =============================================================================
; PROGRAM: icnd2153_gclk
; =============================================================================
; Emits a fixed-length GCLK burst (138 pulses, per the Rigol capture) each
; time it's triggered, then signals completion and waits to be triggered
; again. Knows nothing about rows, frames, or RA - purely "burst N pulses on
; request,".
;
; side-set (1 pin, oen_pin) = GCLK.
;
; IRQ 4 = "start a burst" (from icnd2153_row); IRQ 5 = "burst done" (to
; icnd2153_row). ASSUMPTION: icnd2153_row and icnd2153_gclk end up claimed on
; the SAME PIO block (both should, since rowsel_base_pin/oen_pin are close
; enough to fall in the same GPIO30-47/PIO2 range as everything else in this
; driver) - plain `irq`/`wait irq` numbers only reach other SMs in the same
; block; if they ever land on different blocks this needs the "+4" relative
; cross-block addressing instead.
.program icnd2153_gclk
.side_set 1

.wrap_target
    wait 1 irq 4           side 0   ; wait for icnd2153_row to request a burst
    mov x, y               side 0   ; reload burst length (y seeded once at init = 137)
gclk_loop:
    nop         [3]        side 1   ; GCLK high
    jmp x--, gclk_loop [3] side 0   ; GCLK low; loop 138 times total
    irq nowait 5           side 0   ; signal "burst done" back to icnd2153_row
.wrap

% c-sdk {
    static inline void icnd2153_gclk_program_init(PIO pio, uint sm, uint offset, uint oen_pin, uint32_t gclk_pulses_per_burst)
    {
        pio_sm_set_enabled(pio, sm, false);
        pio_sm_clear_fifos(pio, sm);

        pio_sm_set_consecutive_pindirs(pio, sm, oen_pin, 1, true);
        pio_gpio_init(pio, oen_pin);

        pio_sm_config c = icnd2153_gclk_program_get_default_config(offset);
        sm_config_set_sideset_pins(&c, oen_pin);

        sm_config_set_clkdiv(&c, 10.0f);

        pio_sm_init(pio, sm, offset, &c);

        // Seed y = gclk_pulses_per_burst - 1 (e.g. 137 for a 138-pulse burst)
        // - the only time y is written; every burst reloads x from it.
        pio_sm_exec(pio, sm, pio_encode_out(pio_y, 32));
        pio_sm_put(pio, sm, gclk_pulses_per_burst - 1);

        pio_sm_set_enabled(pio, sm, true);
    }
%}

.program icnd2153_pixel_stream
.side_set 2

.wrap_target
    wait 1 irq 2                side 0b00  ; wait for icnd2153_row's VSYNC request

    set x, 2                    side 0b00 [3]
vsync_loop:                                ; send VSYNC
    nop             [3]         side 0b11
    jmp x--, vsync_loop         side 0b10

    irq nowait 3                side 0b00  ; acknowledge: VSYNC sent

    mov isr, null                side 0b00  ; clear before accumulating this frame's transaction count
    out isr, 8                    side 0b00  ; high byte of 511
    out isr, 8                     side 0b00  ; low byte
    mov x, isr                      side 0b00  ; x = 511 (transactions this frame)

    mov isr, null                    side 0b00  ; clear again - isr's next job is 126, fresh every frame
    out isr, 8                        side 0b00  ; single byte, fits directly - no accumulation needed

transactions:
    mov y, isr                  side 0b00
normal_pulse:
    out pins, 6       [2]       side 0b00
    out null, 2       [3]       side 0b01
    jmp y--, normal_pulse       side 0b00

    out pins, 6       [3]       side 0b00  ; last pulse with DATA_LATCH
    out null, 2       [3]       side 0b11
    jmp x--, transactions       side 0b00
.wrap

% c-sdk {
    static inline void icnd2153_pixel_stream_program_init(PIO pio, uint sm, uint offset, uint rgb_base_pin, uint clk_pin)
    {
        pio_sm_set_enabled(pio, sm, false);
        pio_sm_clear_fifos(pio, sm);

        pio_sm_set_consecutive_pindirs(pio, sm, rgb_base_pin, 6, true);
        pio_sm_set_consecutive_pindirs(pio, sm, clk_pin, 2, true);
        for (uint i = 0; i < 6; i++)
            pio_gpio_init(pio, rgb_base_pin + i);
        pio_gpio_init(pio, clk_pin);
        pio_gpio_init(pio, clk_pin + 1);

        pio_sm_config c = icnd2153_pixel_stream_program_get_default_config(offset);
        sm_config_set_out_pins(&c, rgb_base_pin, 6);
        sm_config_set_sideset_pins(&c, clk_pin);
        sm_config_set_out_shift(&c, true, true, 8);
        sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

        sm_config_set_clkdiv(&c, 10.0f);

        pio_sm_init(pio, sm, offset, &c);

        pio_sm_set_enabled(pio, sm, true);
    }
%}

; =============================================================================
; PROGRAM: icnd2153_write_register
; =============================================================================
; One-time control-command / configuration-register writer for a chain of
; ICND2153 driver ICs. Runs BEFORE normal row/bitplane scanning starts: it
; borrows the PIO/GPIO resources long enough to shift PRE_ACT / EN_OP / VSYNC
; and the WR_CFG1..WR_CFG4 / WR_DBG register values into every daisy-chained
; chip, then hands the PIO block back so icnd2153_row / icnd2153_bitplane_stream
; can drive the panel normally. Directly modelled on rul6024_write_register
; above - the wire protocol is identical: a command is decoded purely by how
; many trailing DCLK rising edges occur while LE (LAT) is held high, per the
; "Control Command" table in icnd2153_control_command.png. See icnd2153.h for
; the command-signature constants and icnd2153.cpp for the C++ driver.
;
; set pin group (clock_base_pin, 3 pins) - SAME ordering as
; icnd2153_bitplane_stream_program_init() above, so both programs can be
; pointed at the same three GPIOs:
;   bit0 (clock_base_pin + 0) = CLK
;   bit1 (clock_base_pin + 1) = LE     (a.k.a. LAT)
;   bit2 (clock_base_pin + 2) = PWCLK  (-> panel OEN pin; held HIGH/blanked
;                                for the whole control-command / register-write
;                                sequence, mirroring how rul6024_write_register
;                                treats OEN, so no write-glitch is visible on
;                                the panel.
;                                ASSUMPTION, please verify against real
;                                hardware: the captured scope trace shows the
;                                OE line toggling *during* the long "write
;                                configuration register" burst - this may be
;                                a free-running signal unrelated to this
;                                write, or PWCLK may actually need to keep
;                                pulsing here. Flagged in the accompanying
;                                chat message.)
;
; "out pins, 6" targets 6 consecutive data pins (rgb_base_pin..+5), one bit
; per RGB sub-pixel lane, driven identically for every chip in the chain (see
; prepare_register_dma() in icnd2153.cpp - the same 16-bit register value is
; shifted once per daisy-chained chip, exactly as for RUL6024).
;
; Wire protocol, per call to icnd2153_write_register() (C-SDK helper below) -
; identical structure to rul6024_write_register():
;
;   Phase 1 (once): receive `data_length = display_width - cmd_signature`,
;     the number of CLK pulses to send with LE held LOW.
;   Phase 2 (data_loop, `data_length` iterations): shift the leading portion
;     of the register image in with LE LOW - still real register data, the
;     chip keeps shifting on every CLK pulse regardless of LE.
;   Phase 3 (le_data_loop, `cmd_signature` iterations): shift the remaining
;     `cmd_signature` pulses in with LE HIGH. Together with Phase 2 this
;     clocks in exactly `display_width` bits total, and the trailing run of
;     `cmd_signature` LE-high pulses is what the chip decodes as the command
;     once CLK stops toggling (1 = DATA_LATCH, 2 = WR_DBG, 3 = VSYNC,
;     4 = WR_CFG1, 6 = WR_CFG2, 8 = WR_CFG3, 10 = WR_CFG4, 12 = EN_OP,
;     13 = DIS_OP, 14 = PRE_ACT - see icnd2153.h).
;
; Timing: sm_config_set_clkdiv(&c, 10.0f) below matches rul6024_write_register's
; divider. If you ever change sys_clk or clkdiv, recompute the resulting CLK
; high/low time and re-check it against the ICND2153's timing spec.
.program icnd2153_write_register
.wrap_target
    ; ---- Phase 1: latch in the data/command split point for this write ----
    pull block
    out x, 32                ; x = data_length - 1 (CLK pulses to send with LE low)
    set pins, 0b100 [7]      ; PWCLK/OEN=1 (blanked), LE=0, CLK=0 — idle/rest state

    ; ---- Phase 2: shift register data in, LE low (not yet part of the command signature) ----
data_loop:
    pull block
    out pins, 6              ; drive this cycle's 6 data lanes (1 bit/lane, all chips identical)
    set pins, 0b101 [7]      ; PWCLK/OEN=1 LE=0 CLK=1  (chip samples data on this rising edge)
    set pins, 0b100 [7]      ; PWCLK/OEN=1 LE=0 CLK=0
    jmp x-- data_loop

    ; ---- Phase 3: shift the final cmd_signature bits in with LE held high ----
    ;              (LE-high pulse *count*, not the data itself, selects the command)
    pull block
    out x, 32                ; x = cmd_signature - 1   e.g. 4->3 for WR_CFG1, 14->13 for PRE_ACT
le_data_loop:
    pull block
    out pins, 6              ; still real shift-register data — LE doesn't gate data, only marks the command
    set pins, 0b111 [7]      ; PWCLK/OEN=1 LE=1 CLK=1  (data sampled on this rising edge)
    set pins, 0b110 [7]      ; PWCLK/OEN=1 LE=1 CLK=0
    jmp x-- le_data_loop
.wrap

% c-sdk {
    // Configures GPIO directions/muxing and the state machine for
    // icnd2153_write_register. Call once per chain before any
    // icnd2153_write_register() / icnd2153_write_control_command() calls;
    // the SM stays enabled and reusable for repeated writes (PRE_ACT, EN_OP,
    // VSYNC, WR_CFG1..4, WR_DBG, DATA_LATCH, ...) until the caller tears it
    // down (see icnd2153_initialize() in icnd2153.cpp).
    //
    //   rgb_base_pin    -> first of 6 consecutive RGB data lane pins
    //   clock_base_pin  -> CLK; clock_base_pin+1 and +2 must be LE and
    //                      PWCLK/OEN respectively (three *consecutive* GPIOs,
    //                      same grouping as icnd2153_bitplane_stream_program_init)
    //
    static inline void icnd2153_write_register_program_init(PIO pio, uint sm, uint offset, uint rgb_base_pin, uint clock_base_pin)
    {
        pio_sm_set_enabled(pio, sm, false);
        pio_sm_clear_fifos(pio, sm);

        pio_sm_set_consecutive_pindirs(pio, sm, rgb_base_pin, 6, true);
        pio_sm_set_consecutive_pindirs(pio, sm, clock_base_pin, 3, true);
        for (uint i = 0; i < 6; i++)
            pio_gpio_init(pio, rgb_base_pin + i);
        pio_gpio_init(pio, clock_base_pin);     // CLK
        pio_gpio_init(pio, clock_base_pin + 1); // LE (LAT)
        pio_gpio_init(pio, clock_base_pin + 2); // PWCLK / OEN

        pio_sm_config c = icnd2153_write_register_program_get_default_config(offset);
        sm_config_set_out_pins(&c, rgb_base_pin, 6);
        sm_config_set_set_pins(&c, clock_base_pin, 3);
        sm_config_set_out_shift(&c, true, false, 32); // shift_right=true, autopull off (all pulls explicit)

        // Divides the PIO clock relative to sys_clk
        sm_config_set_clkdiv(&c, 10.0f);
        sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

        pio_sm_init(pio, sm, offset, &c);
        pio_sm_set_enabled(pio, sm, true);
    }

    // Issues one register write: shifts `dma_words[0 .. display_width-1]` into
    // the chain (one 6-bit word per CLK pulse) and asserts LE for the trailing
    // `cmd_signature` of those pulses, so the chain latches the shifted-in
    // value as the command identified by cmd_signature (e.g.
    // ICND2153_CMD_WR_CFG1 = 4, ICND2153_CMD_WR_CFG2 = 6, ... — see
    // icnd2153.h).
    //
    // dma_words must hold exactly `display_width` entries, pre-expanded by
    // prepare_register_dma() in icnd2153.cpp. This function only streams
    // them to the PIO FIFO, it does no encoding of its own.
    static inline void icnd2153_write_register(PIO pio, uint sm, uint32_t display_width, uint32_t cmd_signature, const uint32_t *dma_words)
    {
        uint16_t data_length = display_width - cmd_signature; // LE-low portion (Phase 2)

        pio_sm_put_blocking(pio, sm, data_length - 1); // Phase 1: loop count for data_loop
        for (uint32_t i = 0; i < data_length; i++)
        {
            pio_sm_put_blocking(pio, sm, dma_words[i]);
        }

        pio_sm_put_blocking(pio, sm, cmd_signature - 1); // Phase 3: loop count for le_data_loop
        for (uint32_t i = data_length; i < data_length + cmd_signature; i++)
        {
            pio_sm_put_blocking(pio, sm, dma_words[i]);
        }
    }

    // Issues a no-payload control command: PRE_ACT, EN_OP, VSYNC, DIS_OP, or
    // DATA_LATCH. Per the Control Command table these carry no register data
    // of their own — the chip only decodes the trailing LE-high pulse count
    // once CLK stops toggling, so what gets shifted through beforehand
    // doesn't matter (mirrors rul6024_data_latch() / rul6024_reset_oen() in
    // hub75.pio, which use the same idiom for RUL6024's no-payload commands).
    //
    // icnd2153_write_register()'s "jmp x--" loop can't do a genuine
    // zero-iteration pass (x = 0 still runs the loop body once before the
    // exit test), so the shortest legal transaction is 1 LE-low dummy pulse
    // followed by the `cmd_signature` LE-high pulses -> display_width =
    // cmd_signature + 1. The dummy data is all zero since the DATA pins are
    // don't-care for these commands.
    static inline void icnd2153_write_control_command(PIO pio, uint sm, uint32_t cmd_signature)
    {
        static const uint32_t dummy[15] = {0}; // sized for the longest command (PRE_ACT, 14 -> display_width 15)
        icnd2153_write_register(pio, sm, /*display_width=*/cmd_signature + 1, cmd_signature, dummy);
    }
%}